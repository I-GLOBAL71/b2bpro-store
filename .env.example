# ═══════════════════════════════════════════════════════════════════════════
#  b2bpro.store — Variables d'environnement
#  Copier vers `.env` (local) ou configurer dans Vercel → Settings → Environment
#  Variables (voir docs/DEPLOIEMENT-VERCEL.md pour le runbook complet).
# ═══════════════════════════════════════════════════════════════════════════

# ── Base de données ──────────────────────────────────────────────────────────
# LOCAL (développement sandbox — SQLite) :
DATABASE_URL="file:/home/z/my-project/db/custom.db"

# PRODUCTION (Neon Postgres) — sur Vercel, remplacer DATABASE_URL par la chaîne
# de connexion Neon (mode « pooled », avec sslmode=require) :
# DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"
# (le schéma Postgres utilisé en production est prisma/schema.postgres.prisma)

# ── URL publique du site (SEO : sitemap, robots, canonicals, JSON-LD) ────────
# Absent en local → https://b2bpro.store (défaut). Sur Vercel, définir :
# NEXT_PUBLIC_SITE_URL="https://b2bpro.store"

# ── Vercel Blob (miniatures/avatars WebP — scripts/thumbs-to-blob.ts) ────────
# Token généré dans Vercel → Storage → b2bpro-store → .env.local copié.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxxxxxx"

# ── PayPal (paiement réel — API REST v2 + SDK JS) ───────────────────────────
# App créée sur developer.paypal.com → « Apps & Credentials ».
# ATTENTION — DEUX ONGLETS, DEUX MONDES :
#   • « Sandbox » : argent factice, tests gratuits. N'est accepté QUE par
#     api-m.sandbox.paypal.com → PAYPAL_ENV="sandbox".
#   • « Live » : ARGENT RÉEL dès la capture. Ces clés ne sont acceptées QUE par
#     api-m.paypal.com → PAYPAL_ENV="live".
#   (Ne PAS se fier au préfixe du Client ID — « Ae… », « AR… », « BAA… » selon
#   l'âge de l'app : le test curl ci-dessous est le seul juge de paix.)
# Vérifier ses clés en 5 s (aucun débit — aucun compte acheteur impliqué) :
#   curl -s -X POST https://api-m.sandbox.paypal.com/v1/oauth2/token \
#     -u "CLIENT_ID:SECRET" -d grant_type=client_credentials
#   → 200 = clé sandbox · 401 invalid_client = ce n'est PAS une clé sandbox
#   (refaire contre https://api-m.paypal.com : 200 = clé live).
# PAYPAL_CLIENT_ID="AeA1QIZXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# PAYPAL_CLIENT_SECRET="EGnHDxD_qRPxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# PAYPAL_ENV="sandbox"   # "sandbox" (défaut) ou "live" — DOIT correspondre à la clé

# ── Google Search Console (vérification de propriété) ───────────────────────
# Google Search Console → Méthode « Balise META » → copier le code.
# GOOGLE_SITE_VERIFICATION="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ── Panneau d'administration (v1.5.0) ────────────────────────────────────────
# Mot de passe de /admin — DÉFAUT « b2bpro-admin » si absent (dev uniquement :
# à ABSOLUMENT définir en production Vercel → Settings → Environment Variables).
# ADMIN_PASSWORD="mot-de-passe-long-et-unique"
#
# Secret de signature des sessions admin (HMAC-SHA256). Optionnel : dérivé
# automatiquement depuis ADMIN_PASSWORD sinon (le changer déconnecte tout le monde).
# ADMIN_SESSION_SECRET="chaine-aleatoire-de-32-caracteres-minimum"

# ── Chat IA par service (v1.10.1 — route /api/service-chat) ──────────────────
# Fournisseur de PRODUCTION : API DeepSeek (https://platform.deepseek.com →
# « API keys »). Sur Vercel → Settings → Environment Variables :
#   • nom EXACT : DEEPSEEK_API_KEY (sensible à la casse, sans guillemets ni
#     espaces autour de la valeur) ;
#   • environnement : **Production** (pas seulement Preview) ;
#   • puis **Redeploy** pour que la variable soit visible du runtime.
#   • compte DeepSeek alimenté : HTTP 402 = solde insuffisant (le ping le dit).
# DEEPSEEK_API_KEY="sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# DEEPSEEK_MODEL="deepseek-chat"   # ou "deepseek-reasoner" (raisonnement long)
#
# Chaîne de repli v1.10.1 (le visiteur ne voit JAMAIS d'erreur) :
#   DeepSeek → passerelle z-ai (fichier .z-ai-config — DEV uniquement, absent
#   de Vercel) → RÉPONSE LOCALE DÉTERMINISTE construite sur les chiffres exacts
#   de la fiche (prix, délais, inclus, garanties) — la conversation continue.
#
# Diagnostic en production : GET https://b2bpro.store/api/service-chat
#   → { diagnostics: { deepseek: { keyPresent, keyFormatOk, model } … } }
#   GET …/api/service-chat?ping=1 → teste la clé EN DIRECT :
#   200 = clé opérationnelle · 401 = clé invalide/mal collée · 402 = solde
#   insuffisant · timeout = flux réseau bloqué.

# ── Notifications du propriétaire-prestataire (v2.2.0) ────────────────────────
# Le propriétaire de la plateforme est AUSSI l'unique prestataire humain.
# Cette boîte est notifiée par email pour : chaque commande (création + paiement
# capturé), chaque nouvelle conversation avec un assistant prestataire IA, et
# chaque question posée au prestataire humain (email marqué URGENT + badge dans
# le panneau /admin/messages). Repli automatique sur SMTP_USER si absente.
# OWNER_EMAIL="proprietaire@b2bpro.store"
#
# L'envoi réel requiert le SMTP ci-dessous (mêmes variables que le lien magique).

# ── Authentification clients (v2.0.0 — Google + lien magique email) ──────────
# GUIDE PAS-À-PAS COMPLET : docs/AUTHENTIFICATION-GOOGLE-EMAIL.md
# Sans ces variables, le site fonctionne : les commandes restent possibles en
# invité ; seuls les boutons de connexion sont masqués.
#
# ── Commandes : authentification IMPOSÉE (v2.1.0) ────────────────────────────
# Dès que l'auth (Google ou lien magique) est configurée sur l'environnement,
# la finalisation d'une commande EXIGE un client connecté : le serveur refuse
# tout POST invité (/api/orders, /api/paypal/create-order) par 401, et l'email
# de SESSION devient l'identité du lead (identité vérifiée, serveur-autoritaire).
# Pour rétablir les commandes invité sur un environnement de TEST uniquement :
# ORDER_ALLOW_GUEST="true"
#
# 1) Secret de signature des sessions (OBLIGATOIRE dès qu'on active l'auth) :
#    générer :  openssl rand -base64 32
# NEXTAUTH_SECRET="chaine-aleatoire-de-32-caracteres-minimum"
#
# 2) URL du site (local : http://localhost:3000 — Vercel la déduit seule,
#    ne la définir QUE si nécessaire) :
# NEXTAUTH_URL="http://localhost:3000"
#
# 3) Google OAuth (console.cloud.google.com → API et services → Identifiants) :
#    écran de consentement OAuth (type Externe) puis « ID client OAuth » →
#    Application Web. URI de redirection AUTORISÉES, exactement :
#      http://localhost:3000/api/auth/callback/google      (développement)
#      https://b2bpro.store/api/auth/callback/google       (production)
# GOOGLE_CLIENT_ID="xxxxxxxx.apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="GOCSPX-xxxxxxxxxxxxxxxxxxxx"
#
# 4) Lien magique email via Gmail (mot de passe APPLICATIF — jamais le mot
#    de passe principal) : compte Google → Sécurité → validation en deux
#    étapes activée → « Mots de passe des applications » → créer « b2bpro-mail »
#    → copier les 16 caractères sans espaces.
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587                 # 587 (STARTTLS) ou 465 (SSL)
# SMTP_USER="votreadresse@gmail.com"
# SMTP_PASSWORD="abcdef1234567890"   # 16 caractères du mot de passe applicatif
# SMTP_FROM="b2bpro.store <votreadresse@gmail.com>"   # optionnel, joli nom
#
# En développement sans SMTP : le lien magique est tracé dans la console du
# serveur (dev.log) — le parcours reste testable sans aucune clé Gmail.
