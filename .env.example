# ═══════════════════════════════════════════════════════════════════════════
#  b2bpro.store — Variables d'environnement
#  Copier vers `.env` (local) ou configurer dans Vercel → Settings → Environment
#  Variables (voir docs/DEPLOIEMENT-VERCEL.md pour le runbook complet).
# ═══════════════════════════════════════════════════════════════════════════

# ── Base de données ──────────────────────────────────────────────────────────
# LOCAL (développement sandbox — SQLite) :
DATABASE_URL="file:/home/z/my-project/db/custom.db"

# PRODUCTION (Neon Postgres) — sur Vercel, remplacer DATABASE_URL par la chaîne
# de connexion Neon (mode « pooled », avec sslmode=require) :
# DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"
# (le schéma Postgres utilisé en production est prisma/schema.postgres.prisma)

# ── URL publique du site (SEO : sitemap, robots, canonicals, JSON-LD) ────────
# Absent en local → https://b2bpro.store (défaut). Sur Vercel, définir :
# NEXT_PUBLIC_SITE_URL="https://b2bpro.store"

# ── Vercel Blob (miniatures/avatars WebP — scripts/thumbs-to-blob.ts) ────────
# Token généré dans Vercel → Storage → b2bpro-store → .env.local copié.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxxxxxx"

# ── PayPal (paiement réel — API REST v2 + SDK JS) ───────────────────────────
# Créer une app sur developer.paypal.com (sandbox) puis la passer en live.
# PAYPAL_CLIENT_ID="AeA1QIZXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# PAYPAL_CLIENT_SECRET="EGnHDxD_qRPxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# PAYPAL_ENV="sandbox"   # "sandbox" (défaut) ou "live"

# ── Google Search Console (vérification de propriété) ───────────────────────
# Google Search Console → Méthode « Balise META » → copier le code.
# GOOGLE_SITE_VERIFICATION="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ── Panneau d'administration (v1.5.0) ────────────────────────────────────────
# Mot de passe de /admin — DÉFAUT « b2bpro-admin » si absent (dev uniquement :
# à ABSOLUMENT définir en production Vercel → Settings → Environment Variables).
# ADMIN_PASSWORD="mot-de-passe-long-et-unique"
#
# Secret de signature des sessions admin (HMAC-SHA256). Optionnel : dérivé
# automatiquement depuis ADMIN_PASSWORD sinon (le changer déconnecte tout le monde).
# ADMIN_SESSION_SECRET="chaine-aleatoire-de-32-caracteres-minimum"

# ── Chat IA par service (v1.10.1 — route /api/service-chat) ──────────────────
# Fournisseur de PRODUCTION : API DeepSeek (https://platform.deepseek.com →
# « API keys »). Sur Vercel → Settings → Environment Variables :
#   • nom EXACT : DEEPSEEK_API_KEY (sensible à la casse, sans guillemets ni
#     espaces autour de la valeur) ;
#   • environnement : **Production** (pas seulement Preview) ;
#   • puis **Redeploy** pour que la variable soit visible du runtime.
#   • compte DeepSeek alimenté : HTTP 402 = solde insuffisant (le ping le dit).
# DEEPSEEK_API_KEY="sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# DEEPSEEK_MODEL="deepseek-chat"   # ou "deepseek-reasoner" (raisonnement long)
#
# Chaîne de repli v1.10.1 (le visiteur ne voit JAMAIS d'erreur) :
#   DeepSeek → passerelle z-ai (fichier .z-ai-config — DEV uniquement, absent
#   de Vercel) → RÉPONSE LOCALE DÉTERMINISTE construite sur les chiffres exacts
#   de la fiche (prix, délais, inclus, garanties) — la conversation continue.
#
# Diagnostic en production : GET https://b2bpro.store/api/service-chat
#   → { diagnostics: { deepseek: { keyPresent, keyFormatOk, model } … } }
#   GET …/api/service-chat?ping=1 → teste la clé EN DIRECT :
#   200 = clé opérationnelle · 401 = clé invalide/mal collée · 402 = solde
#   insuffisant · timeout = flux réseau bloqué.
