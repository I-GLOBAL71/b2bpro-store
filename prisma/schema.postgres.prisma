// ═══════════════════════════════════════════════════════════════════════════
//  Schéma Prisma — b2bpro.store — PRODUCTION (Neon PostgreSQL / Vercel)
// ═══════════════════════════════════════════════════════════════════════════
//
//  ⚠️  MIROIR STRICT de prisma/schema.prisma (SQLite, développement local).
//      Toute évolution de l'un DOIT être répliquée sur l'autre — la commande
//      `bun run db:migrate:neon` copie SQLite → Neon et vérifie les comptes.
//
//  Utilisation (voir docs/DEPLOIEMENT-VERCEL.md) :
//    • Sur Vercel (build)  : `bunx prisma generate --schema prisma/schema.postgres.prisma`
//      (généré vers l'emplacement client par défaut → src/lib/db.ts inchangé).
//    • Création des tables : `bun run db:push:pg` (DATABASE_URL = Neon, pooler).
//    • Migration des données locales : `bun run db:migrate:neon`.
//
//  Les champs JSON restent des colonnes String (TEXT) : la lecture défensive
//  via safeJsonParse (src/lib/contracts.ts) est ainsi identique sur les deux
//  providers — zéro divergence de code applicatif.
// ═══════════════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Vendeurs (profils fictifs FR / CA / AF) ────────────────────────────────
model Seller {
  id           String    @id @default(cuid())
  slug         String    @unique
  name         String
  country      String // FR, CA, SN, CI, CM, MA, CD, BJ, TG, GA, BF, ML, GN, TN
  countryLabel String // "France", "Canada (Québec)", "Sénégal"...
  city         String
  title        String // accroche professionnelle
  bio          String // présentation unique (jamais dupliquée)
  skills       String // JSON array : ["Veille concurrentielle", ...]
  languages    String // JSON array : ["Français", "Anglais"]
  rating       Float // note moyenne 4.2 → 5.0
  reviewsCount Int
  totalSales   Int // ventes cumulées
  responseTime String // "répond en moins de 2 h"
  memberSince  String // "2021"
  level        String // "Confirmé", "Expert", "Élite", "Légende"
  avatarColors String // JSON [c1, c2] pour avatar SVG
  avatarUrl    String? // URL absolue (Vercel Blob WebP) — sinon fallback /avatars/<slug>.svg
  isTop        Boolean   @default(false)
  createdAt    DateTime  @default(now())
  services     Service[]
}

// ─── Services ───────────────────────────────────────────────────────────────
model Service {
  id           String          @id @default(cuid())
  slug         String          @unique
  code         String // "F-01" | "#01"
  name         String // nom long du service
  title        String // titre commercial ComeUp (≈70 car.)
  category     String // catégorie fine
  pole         String // pôle métier (libellé complet)
  poleSlug     String // slug du pôle pour /categories/[slug]
  poleIcon     String // nom d'icône Lucide
  basePrice    Float
  deliveryDays Int
  description  String // description complète markdown (SEO)
  shortDesc    String // résumé 1-2 phrases pour cartes
  keywords     String // JSON { primary, secondary[], longTail[], aiQueries[] }
  faq          String // JSON [{q, a}] — optimisé AIO
  features     String // JSON [string] — points forts
  deliverables String // JSON [string] — livrables
  process      String // JSON [{step, title, detail}] — méthode
  rating       Float // 4.2 → 5.0
  reviewsCount Int
  salesCount   Int // nombre de services déjà réalisés (aléatoire)
  views        Int
  featured     Boolean         @default(false)
  isFounder    Boolean         @default(false)
  thumbUrls    String? // JSON [url1, url2, url3] — miniatures WebP Vercel Blob (sinon fallback local SVG)
  createdAt    DateTime        @default(now())
  sellerId     String
  seller       Seller          @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  options      ServiceOption[]
  reviews      Review[]
  orders       Order[]
}

// ─── Options supplémentaires (upsell à la ComeUp) ──────────────────────────
model ServiceOption {
  id          String  @id @default(cuid())
  serviceId   String
  service     Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  name        String
  description String
  priceExtra  Float
  daysExtra   Int
  monthly     Boolean @default(false)
  position    Int     @default(0)
}

// ─── Avis clients ───────────────────────────────────────────────────────────
model Review {
  id         String   @id @default(cuid())
  serviceId  String
  service    Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  authorName String
  country    String
  rating     Float // 4.2 → 5.0
  comment    String
  orderLabel String // option commandée
  createdAt  DateTime @default(now())
}

// ─── Blog (référencement continu) ──────────────────────────────────────────
model BlogPost {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String
  content     String // markdown
  category    String
  coverTheme  String // thème SVG de couverture
  readMinutes Int
  publishedAt DateTime @default(now())
  author      String
}

// ─── Base de connaissances du support IA ────────────────────────────────────
model KnowledgeItem {
  id       String @id @default(cuid())
  category String // "general" | "plateforme" | "paiement" | slug pôle | slug service
  question String
  answer   String
  keywords String // mots-clés de déclenchement
}

// ─── Leads (email requis avant le support IA) ───────────────────────────────
model Lead {
  id        String        @id @default(cuid())
  email     String        @unique
  name      String?
  source    String // "support-ia", "newsletter", ...
  createdAt DateTime      @default(now())
  messages  ChatMessage[]
  orders    Order[]
}

model ChatMessage {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  role      String // "user" | "assistant"
  content   String
  createdAt DateTime @default(now())
}

// ─── Configuration dynamique du site (panneau d'administration) ──────────────
// v1.5.0 — rotation équitable de la vitrine d'accueil + réglages pilotables.
// Miroir exact de prisma/schema.prisma (SQLite dev) — voir les commentaires là-bas.
model SiteConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ─── Journal d'audit du panneau d'administration ──────────────────────────────
model AdminLog {
  id        String   @id @default(cuid())
  action    String
  detail    String
  createdAt DateTime @default(now())
}

// ─── Comptes clients (v2.0.0 — authentification Google + lien magique email) ─
// Miroir exact de prisma/schema.prisma (SQLite dev) — modèles standard NextAuth.
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Commandes réelles (paiement PayPal) ──────────────────────────────────────
// Modèle additif v1.3.0 : persiste les paiements capturés via l'API PayPal.
model Order {
  id              String    @id @default(cuid())
  reference       String    @unique // "CMD-XXXXXXXX"
  leadId          String
  lead            Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  serviceId       String
  service         Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  serviceSlug     String // dénormalisé — l'URL SEO de la fiche reste traçable
  serviceTitle    String
  optionIds       String    @default("[]") // JSON [string]
  brief           String?
  total           Float // total recalculé SERVEUR
  deliveryDays    Int
  currency        String    @default("EUR")
  paymentProvider String    @default("paypal") // "paypal" | "demo"
  paymentStatus   String    @default("CREATED") // CREATED | PAID | FAILED | REFUNDED
  paypalOrderId   String?   @unique
  paypalCaptureId String?
  payerEmail      String?
  payerName       String?
  createdAt       DateTime  @default(now())
  paidAt          DateTime?
}
