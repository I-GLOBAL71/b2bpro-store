// Schéma Prisma — b2bpro.store
// Place de marché B2B francophone : services, vendeurs, options, avis, blog, base de connaissances IA, leads.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Vendeurs (profils fictifs FR / CA / AF) ────────────────────────────────
model Seller {
  id           String    @id @default(cuid())
  slug         String    @unique
  name         String
  country      String // FR, CA, SN, CI, CM, MA, CD, BJ, TG, GA, BF, ML, GN, TN
  countryLabel String // "France", "Canada (Québec)", "Sénégal"...
  city         String
  title        String // accroche professionnelle
  bio          String // présentation unique (jamais dupliquée)
  skills       String // JSON array : ["Veille concurrentielle", ...]
  languages    String // JSON array : ["Français", "Anglais"]
  rating       Float // note moyenne 4.2 → 5.0
  reviewsCount Int
  totalSales   Int // ventes cumulées
  responseTime String // "répond en moins de 2 h"
  memberSince  String // "2021"
  level        String // "Confirmé", "Expert", "Élite", "Légende"
  avatarColors String // JSON [c1, c2] pour avatar SVG
  avatarUrl    String? // URL absolue (Vercel Blob WebP) — sinon fallback /avatars/<slug>.svg
  isTop        Boolean   @default(false)
  createdAt    DateTime  @default(now())
  services     Service[]
}

// ─── Services ───────────────────────────────────────────────────────────────
model Service {
  id           String          @id @default(cuid())
  slug         String          @unique
  code         String // "F-01" | "#01"
  name         String // nom long du service
  title        String // titre commercial ComeUp (≈70 car.)
  category     String // catégorie fine
  pole         String // pôle métier (libellé complet)
  poleSlug     String // slug du pôle pour /categories/[slug]
  poleIcon     String // nom d'icône Lucide
  basePrice    Float
  deliveryDays Int
  description  String // description complète markdown (SEO)
  shortDesc    String // résumé 1-2 phrases pour cartes
  keywords     String // JSON { primary, secondary[], longTail[], aiQueries[] }
  faq          String // JSON [{q, a}] — optimisé AIO
  features     String // JSON [string] — points forts
  deliverables String // JSON [string] — livrables
  process      String // JSON [{step, title, detail}] — méthode
  rating       Float // 4.2 → 5.0
  reviewsCount Int
  salesCount   Int // nombre de services déjà réalisés (aléatoire)
  views        Int
  featured     Boolean         @default(false)
  isFounder    Boolean         @default(false)
  thumbUrls    String? // JSON [url1, url2, url3] — miniatures WebP Vercel Blob (sinon fallback local SVG)
  createdAt    DateTime        @default(now())
  sellerId     String
  seller       Seller          @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  options      ServiceOption[]
  reviews      Review[]
  orders       Order[]
}

// ─── Options supplémentaires (upsell à la ComeUp) ──────────────────────────
model ServiceOption {
  id          String  @id @default(cuid())
  serviceId   String
  service     Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  name        String
  description String
  priceExtra  Float
  daysExtra   Int
  monthly     Boolean @default(false)
  position    Int     @default(0)
}

// ─── Avis clients ───────────────────────────────────────────────────────────
model Review {
  id         String   @id @default(cuid())
  serviceId  String
  service    Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  authorName String
  country    String
  rating     Float // 4.2 → 5.0
  comment    String
  orderLabel String // option commandée
  // v2.5.0 — avis lié à une commande validée (au plus un par commande : la
  // validation client débloque l'avis, l'unicité empêche le double post).
  orderId    String?  @unique
  order      Order?   @relation(fields: [orderId], references: [id])
  createdAt  DateTime @default(now())
}

// ─── Blog (référencement continu) ──────────────────────────────────────────
model BlogPost {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String
  content     String // markdown
  category    String
  coverTheme  String // thème SVG de couverture
  readMinutes Int
  publishedAt DateTime @default(now())
  author      String
}

// ─── Base de connaissances du support IA ────────────────────────────────────
model KnowledgeItem {
  id       String @id @default(cuid())
  category String // "general" | "plateforme" | "paiement" | slug pôle | slug service
  question String
  answer   String
  keywords String // mots-clés de déclenchement
}

// ─── Leads (email requis avant le support IA) ───────────────────────────────
model Lead {
  id        String        @id @default(cuid())
  email     String        @unique
  name      String?
  source    String // "support-ia", "newsletter", ...
  createdAt DateTime      @default(now())
  messages  ChatMessage[]
  orders    Order[]
}

model ChatMessage {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  role      String // "user" | "assistant"
  content   String
  createdAt DateTime @default(now())
}

// ─── Conversations client ↔ prestataire humain (v2.2.0) ────────────────────
// Le prestataire humain de la plateforme est UNIQUE : le propriétaire.
// Chaque fil est rattaché à l'email vérifié d'un client connecté (session) ;
// chaque question déclenche un email URGENT au propriétaire (OWNER_EMAIL)
// ET une trace « support.message » dans le journal admin (notification /admin/messages).
model SupportThread {
  id             String           @id @default(cuid())
  email          String           @unique // email de session (identité vérifiée)
  name           String?
  status         String           @default("open") // "open" | "closed"
  unreadForOwner Int              @default(0) // questions en attente du propriétaire
  lastMessageAt  DateTime         @default(now())
  createdAt      DateTime         @default(now())
  messages       SupportMessage[]
}

model SupportMessage {
  id        String        @id @default(cuid())
  threadId  String
  thread    SupportThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  role      String // "client" | "owner"
  content   String
  // v2.5.0 — route unique par question : code lisible (Q-XXXXXX) posé à la
  // création d'une question client ; la réponse du support référence CE code
  // (objet email dédié + accusé visuel côté client) — aucun croisement possible.
  reference String?       @unique
  createdAt DateTime      @default(now())
}

// ─── Configuration dynamique du site (panneau d'administration) ──────────────
// v1.5.0 — rotation équitable de la vitrine d'accueil + réglages pilotables.
// Une ligne par groupe de réglages ; `value` est un JSON typé via les contrats
// de src/lib/contracts.ts (section v1.5.0) et fusionné sur les défauts dans
// src/lib/settings.ts. Absence de ligne = valeur par défaut du code.
model SiteConfig {
  key       String   @id // "announcement" | "vitrine" | "hero" | "sections" | "support" | "maintenance" | "seo"
  value     String // JSON du groupe de réglages (forme validée par zod)
  updatedAt DateTime @updatedAt
}

// ─── Journal d'audit du panneau d'administration ──────────────────────────────
// Traçabilité des actions admin : connexions, modifications de configuration,
// changements sur les services. Consultable dans /admin/journal.
model AdminLog {
  id        String   @id @default(cuid())
  action    String // "login" | "logout" | "config.update" | "service.update" | "login.failed"
  detail    String // description lisible (jamais de secret)
  createdAt DateTime @default(now())
}

// ─── Comptes clients (v2.0.0 — authentification Google + lien magique email) ─
// Modèles standard NextAuth (adaptateur Prisma) : comptes OAuth, sessions,
// jetons de vérification du lien magique. Les commandes restent rattachées au
// Lead (email) — l'authentification sert au préremplissage et à /account.
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  // OBLIGATOIRE pour l'adaptateur NextAuth (getUserByAccount interpole
  // provider_providerAccountId). Sans cet index composé, le rappel Google
  // échoue en PrismaClientValidationError → ?error=Callback (v2.1.3).
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Commandes réelles (paiement PayPal) ──────────────────────────────────────
// Modèle additif v1.3.0 : persiste les paiements capturés via l'API PayPal.
// Le récapitulatif client reste attaché au lead (ChatMessage), comme pour la
// voie démo /api/orders — la commande apporte en plus la traçabilité paiement.
model Order {
  id              String    @id @default(cuid())
  reference       String    @unique // "CMD-XXXXXXXX" (même format que la voie démo)
  leadId          String
  lead            Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  serviceId       String
  service         Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  serviceSlug     String // dénormalisé — l'URL SEO de la fiche reste traçable
  serviceTitle    String
  optionIds       String    @default("[]") // JSON [string] — options choisies
  brief           String?
  total           Float // total recalculé SERVEUR (jamais celui du client)
  deliveryDays    Int
  currency        String    @default("EUR")
  paymentProvider String    @default("paypal") // "paypal" | "demo"
  paymentStatus   String    @default("CREATED") // CREATED | PAID | FAILED | REFUNDED
  paypalOrderId   String?   @unique
  paypalCaptureId String?
  payerEmail      String?
  payerName       String?
  createdAt       DateTime  @default(now())
  paidAt          DateTime?

  // ── v2.5.0 — cycle de vie de la prestation (après paiement) ──────────────
  // production : délai en cours (défaut, rétrocompatible avec l'existant) ;
  // revision   : le client a demandé une modification (OrderRevision en attente) ;
  // delivered  : le support a marqué le livrable prêt (validation attendue) ;
  // completed  : le client a validé → fonds libérés au prestataire (releasedAt).
  stage          String   @default("production")
  deliveredAt    DateTime?
  releasedAt     DateTime?
  revisions      OrderRevision[]
  review         Review?
}

// ─── Demandes de modification sur un travail livré/en cours (v2.5.0) ────────
// Chaque demande est horodatée et motivée ; le support la traite puis
// re-marque la commande livrée (nouveau cycle delivered → validation).
model OrderRevision {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reason    String
  status    String   @default("pending") // pending | resolved
  createdAt DateTime @default(now())
}

// ─── Abonnements Web Push (notifications navigateur, v2.4.0) ──────────────────
// Un abonnement par endpoint de navigateur. L'invite bienveillante crée la ligne
// à l'activation ; l'envoi réel (src/lib/push.ts) purge les endpoints morts
// (404/410) au fil des envois. Champs p256dh/auth : clés de chiffrement Push.
model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
